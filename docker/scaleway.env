# Profil SCALEWAY : instance GPU, poids sur le Block Storage monté sur l'instance.
#   docker compose --env-file docker/scaleway.env up -d --build
#
# À VÉRIFIER sur l'instance (`ls /mnt/models`) : ces chemins supposent la disposition du
# README de content_creator/docker/h3 (`hf download --local-dir /mnt/models/MiniMax-H3`).

# Point de montage du Block Storage sur l'HÔTE, monté sur /weights (lecture seule).
WEIGHTS_DIR=/mnt/models

# Chemin DANS LE CONTENEUR du dossier qui contient Ref2VA/.
H3_MODEL_PATH=/weights/MiniMax-H3

# La LoRA fusionnée vient de la machine locale : à copier une fois sur le block.
LORA_DIR=/mnt/models/loras
H3_LORA_FILE=turbo_realism_combo_native.safetensors

H3_NUM_GPUS=2
H3_TP_SIZE=2

# Le LLM de l'agent (service `llm`), à télécharger une fois sur le block (source BF16,
# quantifiée en FP8 au chargement) :
#   hf download DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU --local-dir /mnt/models/Qwen3.8-27B-Heretic
LLM_WEIGHTS_DIR=/mnt/models
LLM_MODEL_PATH=/llm-weights/Qwen3.8-27B-Heretic
LLM_SERVED_NAME=DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU
LLM_QUANTIZATION=fp8
LLM_TP_SIZE=2
