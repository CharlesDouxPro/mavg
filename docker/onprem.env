# Profil ON-PREM : la machine locale, poids dans le cache Hugging Face.
#   docker compose --env-file docker/onprem.env up -d --build

# Dossier de l'HÔTE monté en lecture seule. On monte le dépôt entier, pas le snapshot : les
# fichiers du snapshot sont des liens relatifs vers ../../blobs.
WEIGHTS_DIR=/home/arlq/.cache/huggingface/hub/models--MiniMaxAI--MiniMax-H3

# Où il apparaît DANS LE CONTENEUR. Le nom `models--MiniMaxAI--MiniMax-H3` doit rester dans le
# chemin : c'est à lui que sglang reconnaît le modèle (sinon : repli diffusers, et échec).
WEIGHTS_MOUNT=/weights/models--MiniMaxAI--MiniMax-H3

# Chemin DANS LE CONTENEUR du dossier qui contient Ref2VA/.
H3_MODEL_PATH=/weights/models--MiniMaxAI--MiniMax-H3/snapshots/42ed227ee7df40d41602854ae760620d6eb651fe

# Dossier de l'HÔTE qui contient la LoRA, monté sur /loras.
LORA_DIR=/home/arlq/Documents/testCharles/inference_engine/loras_sglang
H3_LORA_FILE=turbo_realism_combo_native.safetensors

H3_NUM_GPUS=2
H3_TP_SIZE=2

# Le LLM de l'agent (service `llm`). Le cache HF entier est monté sur /llm-weights, où le
# conteneur le cherche hors ligne : `hf download <repo>` une fois sur l'hôte.
#
# Le fine-tune DavidAU (Heretic, sans refus). Publié en GGUF pour llama.cpp, que sglang ne lit
# pas : on sert sa source BF16, quantifiée en FP8 au chargement.
LLM_WEIGHTS_DIR=/home/arlq/.cache/huggingface/hub
LLM_MODEL_PATH=DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU
LLM_SERVED_NAME=DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU
LLM_QUANTIZATION=fp8
# Variante : le Qwen officiel, publié en FP8 (~20 % plus rapide, testé le 2026-10-12).
#LLM_MODEL_PATH=Qwen/Qwen3.8-27B-FP8
#LLM_SERVED_NAME=Qwen/Qwen3.8-27B-FP8
#LLM_QUANTIZATION=
LLM_TP_SIZE=2
